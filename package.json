{
  "name": "yksi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent-agnostic AI coding TUI",
  "bin": {
    "yksi": "bin/yksi.ts"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "demo": "bun src/index.tsx --demo",
    "build": "bun scripts/build.ts",
    "prepare": "bun run --bun husky",
    "format": "bun run --bun biome format --write .",
    "format:check": "bun run --bun biome format .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,jsonc,md,markdown,yml,yaml}": "bun run --bun biome format --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.1.0",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "diff": "^8.0.2",
    "solid-js": "^1.9.16",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
